  "posts": [
    {
      "id": "pst_buying",
      "slug": "buying-your-first-vintage-motorcycle",
      "title": "Buying your first vintage motorcycle: a practical checklist",
      "excerpt": "Paperwork, matching numbers and the questions to ask before you buy a classic bike.",
      "cover": "https://images.unsplash.com/photo-1525013066836-c6090f0ad9d8?auto=format&fit=crop&w=1400&q=80",
      "content": "Buying a vintage motorcycle is part purchase, part adoption. Here is what we check before any bike joins the DreamWheels collection.\n\n## 1. Paperwork first\n\nAn original RC, a clear transfer path and matching engine and frame numbers matter more than shiny paint.\n\n## 2. Listen to it cold\n\nAsk the seller not to warm the bike up before you arrive. A cold start tells you more than any test ride.\n\n## 3. Budget for the first year\n\n- Tyres and tubes\n- A full fluid service\n- Brake shoes and cables\n\nIf you would like a second opinion on a bike you are considering, message us on WhatsApp.",
      "author": "DreamWheels Team",
      "tags": [
        "buying guide",
        "vintage bikes"
      ],
      "published": true,
      "createdAt": "2026-09-01T10:00:00.000Z"
    },
    {
      "id": "pst_restore",
      "slug": "what-a-frame-off-restoration-involves",
      "title": "What a frame-off restoration actually involves",
      "excerpt": "From strip-down to final detailing: the stages of a full restoration and how long each takes.",
      "cover": "https://images.unsplash.com/photo-1486262715619-67b85e0b08d3?auto=format&fit=crop&w=1400&q=80",
      "content": "A frame-off restoration is the most complete work we do. Every component comes off, gets assessed, and is restored or replaced.\n\n## Strip-down and assessment\n\nWe photograph and tag every part before it is removed.\n\n## Frame and paint\n\nThe frame is blasted, straightened if needed, and painted.\n\n## Engine rebuild\n\nBores, pistons, bearings and seals are checked against factory tolerances.",
      "author": "DreamWheels Workshop",
      "tags": [
        "restoration"
      ],
      "published": true,
      "createdAt": "2026-09-12T10:00:00.000Z"
    },
    {
      "id": "pst_scooter",
      "slug": "lambretta-vs-vespa-which-vintage-scooter",
      "title": "Lambretta vs Vespa: which vintage scooter suits you?",
      "excerpt": "Two Italian icons, two very different ownership experiences.",
      "cover": "https://images.unsplash.com/photo-1558981806-ec527fa84c39?auto=format&fit=crop&w=1400&q=80",
      "content": "Both are beautiful, both are rewarding — but they are not the same to own.\n\n## Lambretta\n\nTube frame, centrally mounted engine, and a ride that feels planted.\n\n## Vespa\n\nMonocoque steel body and a side-mounted engine. Parts are generally easier to find.",
      "author": "DreamWheels Team",
      "tags": [
        "vintage scooters"
      ],
      "published": true,
      "createdAt": "2026-09-22T10:00:00.000Z"
    }
  ],
