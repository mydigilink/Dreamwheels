# Public site URL — used for canonical tags, OG images and WhatsApp page links
NEXT_PUBLIC_SITE_URL=https://www.dreamwheels.in

# Admin login (change these!)
ADMIN_USER=admin
ADMIN_PASSWORD=dreamwheels
ADMIN_SECRET=replace-with-a-long-random-string

# Customer sign-in with Google (https://console.cloud.google.com/apis/credentials)
# Authorised redirect URI: <site>/api/auth/oauth/google/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Customer sign-in with Facebook (https://developers.facebook.com/apps)
# Valid OAuth redirect URI: <site>/api/auth/oauth/facebook/callback/
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Optional: public origin used to build OAuth redirect URIs (defaults to the request origin)
# AUTH_URL=https://www.dreamwheels.in
